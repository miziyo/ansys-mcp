{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "Relative artifact identity and integrity evidence.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "ArtifactKind": {
      "description": "Run-bundle artifact categories.",
      "enum": [
        "request",
        "resolved",
        "result",
        "artifact",
        "log"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ExecutionStatus": {
      "description": "Execution outcomes kept separate from numerical and physical quality.",
      "enum": [
        "SUCCEEDED",
        "FAILED_LAUNCH",
        "FAILED_PRECHECK",
        "FAILED_SOLVER",
        "FAILED_POSTPROCESS",
        "BLOCKED_ENVIRONMENT",
        "CANCELLED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "VerificationStatus": {
      "description": "Allowed status values for independent result checks.",
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_RUN",
        "NOT_AVAILABLE",
        "INCONCLUSIVE",
        "PARTIAL"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "$id": "https://ansys-research-runner.local/schemas/run-bundle-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete versioned provenance manifest for one run bundle.",
  "properties": {
    "ansys_release": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ansys Release"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "backend_capabilities": {
      "additionalProperties": true,
      "title": "Backend Capabilities",
      "type": "object"
    },
    "cae_ir_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cae Ir Sha256"
    },
    "execution_status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "geometry_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geometry Sha256"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "git_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Dirty"
    },
    "host_os": {
      "title": "Host Os",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "mesh_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mesh Sha256"
    },
    "pyansys_packages": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pyansys Packages",
      "type": "object"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "validation_status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "host_os",
    "python_version",
    "execution_status",
    "validation_status"
  ],
  "title": "RunBundleManifest",
  "type": "object"
}
